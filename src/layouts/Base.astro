---
import '../styles/global.css';
import { SITE } from '../data/content';
import { withBase } from '../lib/base';

const { title = SITE.name, desc = 'Bitombang photography portfolio — collection, project, about, contact.', wide = false } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: withBase('/'), label: 'Collection' },
  { href: withBase('/project'), label: 'Project' },
  { href: withBase('/about'), label: 'About' },
  { href: withBase('/contact'), label: 'Contact' },
];
const socials = [
  { href: (SITE as { youtube?: string }).youtube, label: 'YouTube' },
  { href: SITE.instagram, label: 'Instagram' },
].filter((s) => s.href);
const active = (h: string) => (h === '/' ? path === '/' : path.startsWith(h));
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} — {SITE.name}</title>
  <meta name="description" content={desc} />
  <meta property="og:title" content={`${title} — ${SITE.name}`} />
  <meta property="og:description" content={desc} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={Astro.url.href} />
  <meta property="og:image" content="https://picsum.photos/seed/bt-og/1200/630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#f8f7f3" />
  <link rel="canonical" href={Astro.url.href} />
  <link rel="preconnect" href="https://picsum.photos" />
  <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet" />
</head>
<body class="antialiased">
  <!-- hamburger mobile -->
  <button id="menuBtn" aria-label="Open menu"
    class="fixed right-4 top-4 z-50 rounded-full px-4 py-2 font-sans text-sm md:hidden" style="background:#1a1a1a;color:#f8f7f3">
    Menu
  </button>

  <div class="md:flex md:min-h-screen">
    <!-- sidebar -->
    <aside id="sidebar"
      class="fixed inset-y-0 left-0 z-40 hidden w-[280px] min-w-[280px] flex-col justify-between overflow-y-auto border-r border-line bg-paper p-8 font-sans md:sticky md:top-0 md:flex md:h-screen" style="padding:56px 44px">
      <div>
        <a href={withBase('/')} class="block">
          <div class="text-[28px] font-bold uppercase leading-tight tracking-[0.01em]">{SITE.name}</div>
          <div class="mb-14 mt-1.5 text-sm uppercase tracking-[0.08em] text-mute">{SITE.tagline}</div>
        </a>
        <nav class="flex flex-col gap-5">
          {nav.map((n) => (
            <a href={n.href}
              class:list={['text-lg transition-colors hover:text-ink', active(n.href) ? 'font-semibold text-ink' : 'text-clay']}>
              {n.label}
            </a>
          ))}
        </nav>
      </div>
      <div class="mt-6 flex flex-col gap-3">
        {socials.map((s) => (
          <a href={s.href} target="_blank" rel="noreferrer" class="text-sm tracking-[0.03em] text-mute hover:text-ink">
            {s.label}
          </a>
        ))}
        <div class="mt-2 text-xs tracking-[0.04em] text-[#b0aba1]">© {new Date().getFullYear()} {SITE.name}</div>
      </div>
    </aside>

    <!-- backdrop menu mobile -->
    <div id="backdrop" class="fixed inset-0 z-30 hidden bg-ink/50 md:hidden"></div>

    <!-- konten -->
    <div class="min-w-0 flex-1">
      <main class:list={[wide ? 'px-4 pb-16 pt-14 md:px-8 md:pt-10' : 'mx-auto max-w-6xl px-4 pb-24 pt-16 md:px-8 md:pt-10']}>
        <slot />
      </main>
    </div>
  </div>

  <script>
    const btn = document.getElementById('menuBtn');
    const bar = document.getElementById('sidebar');
    const drop = document.getElementById('backdrop');
    const setMenu = (open) => {
      bar?.classList.toggle('hidden', !open);
      bar?.classList.toggle('flex', open);
      drop?.classList.toggle('hidden', !open);
      if (btn) btn.textContent = open ? 'Close' : 'Menu';
    };
    btn?.addEventListener('click', () => setMenu(bar?.classList.contains('hidden')));
    drop?.addEventListener('click', () => setMenu(false));
    // close menu after navigation on mobile
    bar?.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => {
        if (window.innerWidth < 768) setMenu(false);
      })
    );
  </script>
</body>
</html>
