---
import '../styles/global.css';
import { SITE } from '../data/content';

const { title = SITE.name, desc = 'Portofolio fotografi Bitombang — collection, project, about, contact.' } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Collection' },
  { href: '/project', label: 'Project' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const active = (h: string) => (h === '/' ? path === '/' : path.startsWith(h));
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} — {SITE.name}</title>
  <meta name="description" content={desc} />
  <meta property="og:title" content={`${title} — ${SITE.name}`} />
  <meta property="og:description" content={desc} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={`${SITE.url}${Astro.url.pathname}`} />
  <meta property="og:image" content="https://picsum.photos/seed/bt-og/1200/630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#f5f1ea" />
  <link rel="canonical" href={`${SITE.url}${Astro.url.pathname}`} />
  <link rel="preconnect" href="https://picsum.photos" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body class="font-sans antialiased">
  <!-- hamburger mobile -->
  <button id="menuBtn" aria-label="Open menu"
    class="fixed left-4 top-4 z-50 rounded-full bg-ink px-4 py-2 text-sm text-paper md:hidden" style="background:#161412;color:#f5f1ea">
    Menu
  </button>

  <!-- sidebar -->
  <aside id="sidebar"
    class="fixed inset-y-0 left-0 z-40 hidden w-[280px] flex-col justify-between border-r border-ink/10 bg-paper p-8 md:flex">
    <div>
      <a href="/" class="font-display text-3xl font-semibold tracking-tight">BITOMBANG</a>
      <p class="mt-1 text-sm text-ink/60">{SITE.tagline} · {SITE.location}</p>
      <nav class="mt-10 flex flex-col gap-1">
        {nav.map((n) => (
          <a href={n.href}
            class:list={['flex items-center gap-3 rounded px-3 py-2 text-lg transition-colors hover:bg-ink/5', active(n.href) && 'font-semibold']}>
            <span class:list={['h-1.5 w-1.5 shrink-0 rounded-full', active(n.href) ? 'bg-ink' : 'bg-ink/20']}></span>
            {n.label}
          </a>
        ))}
      </nav>
    </div>
    <div>
      <div class="flex gap-4 text-sm">
        <a href={SITE.instagram} target="_blank" rel="noreferrer" class="underline underline-offset-4">IG</a>
        <a href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noreferrer" class="underline underline-offset-4">WA</a>
        <a href={`mailto:${SITE.email}`} class="underline underline-offset-4">Email</a>
      </div>
      <p class="mt-4 text-xs text-ink/50">{SITE.location}<br />© {new Date().getFullYear()} {SITE.name}</p>
    </div>
  </aside>

  <!-- backdrop menu mobile -->
  <div id="backdrop" class="fixed inset-0 z-30 hidden bg-ink/50 md:hidden"></div>

  <!-- konten -->
  <div class="min-h-screen md:pl-[280px]">
    <main class="mx-auto max-w-6xl px-4 pb-24 pt-16 md:px-8 md:pt-10">
      <slot />
    </main>
  </div>

  <script>
    const btn = document.getElementById('menuBtn');
    const bar = document.getElementById('sidebar');
    const drop = document.getElementById('backdrop');
    const setMenu = (open) => {
      bar?.classList.toggle('hidden', !open);
      bar?.classList.toggle('flex', open);
      drop?.classList.toggle('hidden', !open);
      if (btn) btn.textContent = open ? 'Close' : 'Menu';
    };
    btn?.addEventListener('click', () => setMenu(bar?.classList.contains('hidden')));
    drop?.addEventListener('click', () => setMenu(false));
    // close menu after navigation on mobile
    bar?.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => {
        if (window.innerWidth < 768) setMenu(false);
      })
    );
  </script>
</body>
</html>
