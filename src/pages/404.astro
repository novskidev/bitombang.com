---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/base';
---
<Base title="Page not found" desc="This page does not exist.">
  <div class="py-24 text-center">
    <p class="font-sans text-7xl font-semibold">404</p>
    <p class="mt-4 text-ink/60">This frame was never shot. Let's head back.</p>
    <a href={withBase('/')} class="mt-8 inline-block rounded-full px-6 py-3 font-sans text-paper" style="background:#161412">
      Back to Collection
    </a>
  </div>
</Base>
