---
import Base from '../layouts/Base.astro';
---
<Base title="Thanks" desc="Your message has been sent.">
  <div class="py-24 text-center">
    <p class="font-sans text-5xl font-semibold">Thanks!</p>
    <p class="mt-4 text-ink/60">Your message is on its way — expect a reply within 24 hours on working days.</p>
    <a href="/" class="mt-8 inline-block rounded-full px-6 py-3 font-sans text-paper" style="background:#161412">
      Back to Collection
    </a>
  </div>
</Base>
