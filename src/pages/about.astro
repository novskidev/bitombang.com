---
import Base from '../layouts/Base.astro';
import { ABOUT, AWARDS } from '../data/content';
import { withBase } from '../lib/base';
---
<Base title="About" desc="About Budi Pambudi — photographer.">
  <div class="grid gap-12 md:grid-cols-[360px_1fr] md:gap-16">
    <img src={ABOUT.photo.src} alt={ABOUT.photo.alt}
      width="720" height="900" class="aspect-[4/5] w-full object-cover" />
    <div class="max-w-2xl">
      <h1 class="font-sans text-4xl font-semibold">{ABOUT.heading}</h1>
      <p class="mt-4 leading-relaxed text-ink/80">{ABOUT.intro}</p>

      <figure class="mt-14 md:mt-20">
        <span class="block font-sans text-[64px] leading-none text-ink/15" aria-hidden="true">“</span>
        <blockquote class="-mt-6 text-[28px] italic leading-snug md:text-[34px]">
          {ABOUT.quote}
        </blockquote>
      </figure>

      <h2 class="mt-16 font-sans text-sm text-ink/50">Awards & exhibitions</h2>
      <ul class="mt-4 divide-y divide-ink/10">
        {AWARDS.map((a) => (
          <li class="flex gap-6 py-3">
            <span class="w-14 shrink-0 font-sans text-ink/50">{a.year}</span>
            <span class="text-ink/80">{a.text}</span>
          </li>
        ))}
      </ul>

      <a href={withBase('/contact')} class="mt-12 inline-block border-b border-ink pb-1 font-sans">
        Book a session →
      </a>
    </div>
  </div>
</Base>
