---
import Base from '../layouts/Base.astro';
import { SITE, AWARDS } from '../data/content';
---
<Base title="About" desc="About Bitombang — photographer.">
  <div class="grid gap-10 md:grid-cols-[280px_1fr]">
    <img src="https://picsum.photos/seed/bt-profile/560/700" alt="Photo of Bitombang"
      width="560" height="700" class="w-full object-cover" />
    <div>
      <h1 class="font-display text-4xl font-semibold">Hi, I'm Bitombang.</h1>
      <p class="mt-4 max-w-2xl leading-relaxed text-ink/80">
        A photographer based in {SITE.location}. I shoot weddings, portraits, and landscapes —
        with a warm, candid style and minimal stiff posing. For me, the best photo is the one
        that makes you remember the day, not just see the result.
      </p>
      <h2 class="mt-10 font-display text-2xl">Awards & exhibitions</h2>
      <ul class="mt-4 space-y-2">
        {AWARDS.map((a) => (
          <li class="flex gap-4"><span class="w-12 shrink-0 font-medium">{a.year}</span><span class="text-ink/80">{a.text}</span></li>
        ))}
      </ul>
      <a href="/contact" class="mt-10 inline-block rounded-full px-6 py-3 text-paper" style="background:#161412">
        Book a session →
      </a>
    </div>
  </div>
</Base>
