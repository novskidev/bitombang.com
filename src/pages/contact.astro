---
import Base from '../layouts/Base.astro';
import { SITE, CONTACT } from '../data/content';
const thanksUrl = new URL(`${import.meta.env.BASE_URL}thanks`.replace('//', '/'), Astro.site).href;
const channels = [
  {
    href: `mailto:${SITE.email}`, label: 'Email', value: SITE.email,
    icon: '', viewBox: '', external: false,
  },
  {
    href: SITE.instagram, label: 'Instagram', value: 'Instagram',
    icon: 'M224.1 141c-63.6 0-114.9 51.3-114.9 114.9s51.3 114.9 114.9 114.9S339 319.5 339 255.9 287.7 141 224.1 141zm0 189.6c-41.1 0-74.7-33.5-74.7-74.7s33.5-74.7 74.7-74.7 74.7 33.5 74.7 74.7-33.6 74.7-74.7 74.7zm146.4-194.3c0 14.9-12 26.8-26.8 26.8-14.9 0-26.8-12-26.8-26.8s12-26.8 26.8-26.8 26.8 12 26.8 26.8zm76.1 27.2c-1.7-35.9-9.9-67.7-36.2-93.9-26.2-26.2-58-34.4-93.9-36.2-37-2.1-147.9-2.1-184.9 0-35.8 1.7-67.6 9.9-93.9 36.1s-34.4 58-36.2 93.9c-2.1 37-2.1 147.9 0 184.9 1.7 35.9 9.9 67.7 36.2 93.9s58 34.4 93.9 36.2c37 2.1 147.9 2.1 184.9 0 35.9-1.7 67.7-9.9 93.9-36.2 26.2-26.2 34.4-58 36.2-93.9 2.1-37 2.1-147.8 0-184.8zM398.8 388c-7.8 19.6-22.9 34.7-42.6 42.6-29.5 11.7-99.5 9-132.1 9s-102.7 2.6-132.1-9c-19.6-7.8-34.7-22.9-42.6-42.6-11.7-29.5-9-99.5-9-132.1s-2.6-102.7 9-132.1c7.8-19.6 22.9-34.7 42.6-42.6 29.5-11.7 99.5-9 132.1-9s102.7-2.6 132.1 9c19.6 7.8 34.7 22.9 42.6 42.6 11.7 29.5 9 99.5 9 132.1s2.7 102.7-9 132.1z',
    viewBox: '0 0 448 512', external: true,
  },
];
---
<Base title="Contact" desc="Contact Budi Pambudi to book a photo session.">
  <div class="grid gap-14 md:grid-cols-[340px_1fr] md:gap-16">
    <div>
      <img src={CONTACT.photo.src} alt={CONTACT.photo.alt}
        width="680" height="850" class="aspect-[4/5] w-full object-cover" />
      <h1 class="mt-8 font-sans text-3xl font-semibold">{CONTACT.heading}</h1>
      <p class="mt-2 text-ink/60">{CONTACT.note}</p>

      <ul class="mt-8 divide-y divide-ink/10 border-t border-ink/10 font-sans">
        {channels.map((c) => (
          <li>
            <a href={c.href} target={c.external ? '_blank' : undefined} rel={c.external ? 'noreferrer' : undefined}
              class="group flex min-w-0 items-center gap-3 py-3.5">
              {c.icon ? (
                <svg viewBox={c.viewBox} class="h-4 w-4 shrink-0 fill-ink/40 transition-colors group-hover:fill-ink" aria-hidden="true"><path d={c.icon} /></svg>
              ) : (
                <svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0 stroke-ink/40 transition-colors group-hover:stroke-ink" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
              )}
              <span class="w-20 shrink-0 text-sm text-ink/50">{c.label}</span>
              <span class="min-w-0 truncate border-b border-transparent group-hover:border-ink">{c.value}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-4 font-sans text-sm text-ink/50">{SITE.location}</p>
    </div>

    <form action="https://api.web3forms.com/submit" method="POST" class="max-w-xl space-y-8 font-sans">
      <input type="hidden" name="access_key" value={SITE.web3formsKey} />
      <input type="hidden" name="subject" value="New message from bitombang.com" />
      <input type="hidden" name="redirect" value={thanksUrl} />
      <input type="checkbox" name="botcheck" class="hidden" style="display:none" />
      <label class="block">
        <span class="text-sm text-ink/50">Name</span>
        <input required name="name" placeholder="Your name"
          class="mt-1 w-full border-b border-ink/20 bg-transparent py-2 outline-none focus:border-ink" />
      </label>
      <label class="block">
        <span class="text-sm text-ink/50">Email</span>
        <input required type="email" name="email" placeholder="you@email.com"
          class="mt-1 w-full border-b border-ink/20 bg-transparent py-2 outline-none focus:border-ink" />
      </label>
      <label class="block">
        <span class="text-sm text-ink/50">Message</span>
        <textarea required name="message" rows="3" placeholder="Tell me what you need…"
          class="mt-1 w-full border-b border-ink/20 bg-transparent py-2 outline-none focus:border-ink"></textarea>
      </label>
      <button class="rounded-full px-6 py-3 text-paper" style="background:#161412">Send message</button>
    </form>
  </div>
</Base>
