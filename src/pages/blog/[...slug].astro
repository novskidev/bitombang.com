---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/base';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((p) => !p.data.draft);
  return posts.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const { Content } = await p.render();
---
<Base title={p.data.title} desc={p.data.excerpt}>
  <a href={withBase('/blog')} class="text-sm underline underline-offset-4">← All posts</a>
  <h1 class="mt-4 max-w-3xl font-sans text-4xl font-semibold">{p.data.title}</h1>
  <p class="mt-1 text-sm text-ink/60">
    {p.data.date.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}
  </p>
  {p.data.cover && (
    <img src={p.data.cover} alt={p.data.title} class="mt-6 aspect-[3/2] w-full max-w-3xl object-cover" />
  )}
  <div class="prose-blog mt-6 max-w-2xl text-ink/80">
    <Content />
  </div>
</Base>

<style>
  .prose-blog :global(h2) { font-size: 1.5rem; font-weight: 600; margin: 1.5em 0 0.5em; font-family: Helvetica, Arial, sans-serif; }
  .prose-blog :global(p) { margin: 1em 0; line-height: 1.75; }
  .prose-blog :global(img) { margin: 1.5em 0; width: 100%; }
  .prose-blog :global(a) { text-decoration: underline; text-underline-offset: 4px; }
  .prose-blog :global(ul) { list-style: disc; padding-left: 1.5em; margin: 1em 0; }
  .prose-blog :global(ol) { list-style: decimal; padding-left: 1.5em; margin: 1em 0; }
</style>
